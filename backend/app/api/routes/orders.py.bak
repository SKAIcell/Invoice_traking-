
from decimal import Decimal

from fastapi import (
    APIRouter,
    Depends,
    HTTPException,
    Query,
)
from sqlalchemy import func
from sqlalchemy.exc import IntegrityError
from sqlalchemy.orm import Session

from app.db.session import get_db
from app.models.party import Party
from app.models.budget import Budget
from app.models.order import Order

from app.schemas.order import (
    OrderCreate,
    OrderUpdate,
    OrderResponse,
    validate_fy_date,
)


router = APIRouter(
    prefix="/orders",
    tags=["Orders"],
)


def committed_amount(
    db: Session,
    budget_id: int,
    exclude_order_id: int | None = None,
):
    query = db.query(
        func.coalesce(func.sum(Order.amount), 0)
    ).filter(
        Order.order_type == "PO",
        Order.budget_id == budget_id,
        Order.status != "CANCELLED",
    )

    if exclude_order_id is not None:
        query = query.filter(
            Order.id != exclude_order_id
        )

    return Decimal(str(query.scalar()))


def validate_party(
    db: Session,
    party_id: int,
    order_type: str,
):
    party = db.get(Party, party_id)

    if not party:
        raise HTTPException(
            status_code=404,
            detail="Party not found",
        )

    expected = (
        "VENDOR" if order_type == "PO"
        else "CUSTOMER"
    )

    if (party.party_type or "").strip().upper() != expected:
        raise HTTPException(
            status_code=422,
            detail=f"{order_type} requires a {expected}",
        )

    if not party.is_active:
        raise HTTPException(
            status_code=422,
            detail="Party is inactive",
        )

    return party


@router.post(
    "",
    response_model=OrderResponse,
    status_code=201,
)
def create_order(
    payload: OrderCreate,
    db: Session = Depends(get_db),
):
    budget = None

    if payload.order_type == "PO":
        # Serialize budget-consuming transactions.
        budget = (
            db.query(Budget)
            .filter(Budget.id == payload.budget_id)
            .with_for_update()
            .one_or_none()
        )

        if budget is None:
            raise HTTPException(
                status_code=404,
                detail="Budget not found",
            )

        if budget.financial_year != payload.financial_year:
            raise HTTPException(
                status_code=422,
                detail="Order FY does not match budget FY",
            )

    validate_party(
        db,
        payload.party_id,
        payload.order_type,
    )

    existing = (
        db.query(Order.id)
        .filter(
            Order.order_type == payload.order_type,
            Order.order_number == payload.order_number,
        )
        .first()
    )

    if existing:
        raise HTTPException(
            status_code=409,
            detail="Order number already exists",
        )

    if budget is not None:
        committed = committed_amount(db, budget.id)

        available = budget.approved_amount - committed

        if payload.amount > available:
            raise HTTPException(
                status_code=422,
                detail={
                    "message": "Insufficient approved budget",
                    "approved": str(budget.approved_amount),
                    "committed": str(committed),
                    "available": str(available),
                },
            )

    order = Order(
        **payload.model_dump(),
        status="OPEN",
    )

    db.add(order)

    try:
        db.commit()
        db.refresh(order)
    except IntegrityError:
        db.rollback()
        raise HTTPException(
            status_code=409,
            detail="Order violates a database constraint",
        )

    return order


@router.get(
    "/search",
    response_model=list[OrderResponse],
)
def search_orders(
    q: str = Query(min_length=1),
    db: Session = Depends(get_db),
):
    search_text = q.strip()

    if not search_text:
        raise HTTPException(
            status_code=422,
            detail="Search text cannot be empty",
        )

    return (
        db.query(Order)
        .filter(Order.order_number.ilike(
            f"%{search_text}%"
        ))
        .order_by(Order.created_at.desc())
        .limit(100)
        .all()
    )


@router.get(
    "",
    response_model=list[OrderResponse],
)
def list_orders(
    order_type: str | None = None,
    financial_year: str | None = None,
    db: Session = Depends(get_db),
):
    query = db.query(Order)

    if order_type:
        order_type = order_type.strip().upper()

        if order_type not in ("PO", "SO"):
            raise HTTPException(
                status_code=422,
                detail="Order type must be PO or SO",
            )

        query = query.filter(
            Order.order_type == order_type
        )

    if financial_year:
        query = query.filter(
            Order.financial_year == financial_year
        )

    return query.order_by(
        Order.created_at.desc()
    ).limit(100).all()


@router.get(
    "/{order_id}",
    response_model=OrderResponse,
)
def get_order(
    order_id: int,
    db: Session = Depends(get_db),
):
    order = db.get(Order, order_id)

    if not order:
        raise HTTPException(
            status_code=404,
            detail="Order not found",
        )

    return order


@router.patch(
    "/{order_id}",
    response_model=OrderResponse,
)
def update_order(
    order_id: int,
    payload: OrderUpdate,
    db: Session = Depends(get_db),
):
    changes = payload.model_dump(exclude_unset=True)

    if not changes:
        raise HTTPException(
            status_code=400,
            detail="No changes supplied",
        )

    if (
        ("amount" in changes and changes["amount"] is None)
        or
        ("order_date" in changes and changes["order_date"] is None)
    ):
        raise HTTPException(
            status_code=422,
            detail="Amount and order date cannot be null",
        )

    initial_order = db.get(Order, order_id)

    if initial_order is None:
        raise HTTPException(
            status_code=404,
            detail="Order not found",
        )

    budget = None

    if initial_order.order_type == "PO":
        # Lock budget first so concurrent PO creation
        # and amount editing use the same lock order.
        budget = (
            db.query(Budget)
            .filter(Budget.id == initial_order.budget_id)
            .with_for_update()
            .one_or_none()
        )

        if budget is None:
            raise HTTPException(
                status_code=409,
                detail="Linked budget missing",
            )

    order = (
        db.query(Order)
        .filter(Order.id == order_id)
        .with_for_update()
        .one_or_none()
    )

    if order is None:
        raise HTTPException(
            status_code=404,
            detail="Order not found",
        )

    if order.status != "OPEN":
        raise HTTPException(
            status_code=409,
            detail="Only OPEN orders can be edited",
        )

    new_date = changes.get(
        "order_date", order.order_date
    )

    try:
        validate_fy_date(
            order.financial_year,
            new_date,
        )
    except ValueError as exc:
        raise HTTPException(
            status_code=422,
            detail=str(exc),
        )

    new_amount = changes.get(
        "amount", order.amount
    )

    if budget is not None:
        other_commitments = committed_amount(
            db,
            budget.id,
            exclude_order_id=order.id,
        )

        if (
            other_commitments + new_amount
            > budget.approved_amount
        ):
            raise HTTPException(
                status_code=422,
                detail="Updated order exceeds available budget",
            )

    for field, value in changes.items():
        setattr(order, field, value)

    try:
        db.commit()
        db.refresh(order)
    except IntegrityError:
        db.rollback()
        raise HTTPException(
            status_code=409,
            detail="Order update violates a constraint",
        )

    return order
