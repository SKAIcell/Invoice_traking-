# Application
APP_NAME=Invoice Tracking
APP_VERSION=1.0.0

# MySQL Database
DATABASE_URL=mysql+pymysql://YOUR_DB_USERNAME:YOUR_DB_PASSWORD@localhost:3306/invoice_tracker

# Application Security
SECRET_KEY=REPLACE_WITH_A_UNIQUE_SECRET_KEY

# SMTP Email Configuration
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_EMAIL_ADDRESS
SMTP_PASSWORD=YOUR_EMAIL_PASSWORD
EMAIL_SENDER=YOUR_SENDER_EMAIL_ADDRESS

# Approval Notifications
IT_HEAD_EMAIL=
ACCOUNTS_EMAIL=

# Outlook Actionable Messages
PUBLIC_BACKEND_URL=
ACTIONABLE_MESSAGE_ORIGINATOR=